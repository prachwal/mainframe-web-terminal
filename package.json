{
  "name": "mainframe-web-terminal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://mainframe-web-terminal.netlify.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/prachwal/mainframe-web-terminal.git"
  },
  "bugs": {
    "url": "https://github.com/prachwal/mainframe-web-terminal/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest",
    "lint": "eslint . && markdownlint-cli2 'src/**/*.md' 'README.md' 'AGENTS.md'",
    "lint:fix": "eslint . --fix && markdownlint-cli2 'src/**/*.md' 'README.md' 'AGENTS.md' --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commitlint": "commitlint --edit",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "netlify dev:exec drizzle-kit migrate",
    "db:studio": "netlify dev:exec drizzle-kit studio"
  },
  "dependencies": {
    "@netlify/database": "^1.0.0",
    "@netlify/functions": "^5.2.1",
    "@reduxjs/toolkit": "^2.12.0",
    "drizzle-orm": "1.0.0-beta.22",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "drizzle-kit": "1.0.0-beta.22",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.8.3",
    "sass": "^1.99.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  }
}